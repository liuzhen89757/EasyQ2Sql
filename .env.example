# ============================================================================
# EasyQ2Sql — Environment Variables Template
#
#   cp .env.example .env   (then fill in your real values)
#
# This file is safe to commit. The real .env is gitignored.
# ============================================================================

# --- LLM (used by chat / send_message) ---
LLM_MODEL=your_model
LLM_API_KEY=your_api_key
LLM_BASE_URL=your_base_url

# --- Metric-extraction LLM (dedicated model for metric extraction; leave empty to fall back to the LLM_* vars above) ---
METRIC_EXTRACTION_LLM_MODEL=your_extraction_model
METRIC_EXTRACTION_LLM_API_KEY=your_extraction_api_key
METRIC_EXTRACTION_LLM_BASE_URL=your_extraction_base_url

# --- Target database (the database users query via natural language) ---
DB_TYPE=your_db_type
DB_HOST=your_host
DB_PORT=your_port
DB_NAME=your_database
DB_USER=your_user
DB_PASSWORD=your_password

# --- Metadata store (PostgreSQL + pgvector for schema / metric / agent memory) ---
PG_HOST=your_host
PG_PORT=your_port
PG_DATABASE=your_database
PG_USER=your_user
PG_PASSWORD=your_password

# --- Neo4j (metric graph store, for "Sync to Neo4j") ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_WORKSPACE=base

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# --- Misc ---
CONVERSATIONS_DIR=./conversations
